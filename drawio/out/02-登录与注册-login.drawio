e=11;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="557" y="812" width="500" height="16" as="geometry"/></mxCell><mxCell id="c61" value="忘记密码" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=0;align=right;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="823" y="809" width="80" height="16" as="geometry"/></mxCell><mxCell id="c62" value="登录后继续学习" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#4F46E5;strokeColor=#4F46E5;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="537" y="837" width="366" height="40" as="geometry"/></mxCell><mxCell id="c63" value="安心连接，守护每一次成长" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#9CA3AF;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="537" y="889" width="366" height="14" as="geometry"/></mxCell><mxCell id="c64" value="先逛逛学习空间 ↗" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#1F2937;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="537" y="911" width="366" height="38" as="geometry"/></mxCell><mxCell id="c65" value="不必光芒万丈，只要一直向前。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#9CA3AF;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="998" width="1360" height="16" as="geometry"/></mxCell><mxCell id="c66" value="表单规则&lt;br&gt;· 邮箱格式校验&lt;br&gt;· 密码 ≤ 72 字节且字母 + 数字&lt;br&gt;· 两次密码一致&lt;br&gt;· 验证码 6 位、60 秒可重发&lt;br&gt;· 提交中禁用按钮并显示 loading" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;dashed=0;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1150" y="348" width="226" height="180" as="geometry"/></mxCell><mxCell id="c67" value="成功后&lt;br&gt;· setMode('live')&lt;br&gt;· 按 route.query.redirect 跳转&lt;br&gt;· 无 redirect 时跳 roleHome(role)&lt;br&gt;· ADMIN → /admin&lt;br&gt;· TEACHER → /teacher&lt;br&gt;· STUDENT → /dashboard" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;dashed=0;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1150" y="548" width="226" height="200" as="geometry"/></mxCell><mxCell id="c68" value="页内状态&lt;br&gt;· 模式：登录 / 注册 / 设置密码&lt;br&gt;· 重置密码时 h1 变为「重置密码」&lt;br&gt;· demo 按钮「先逛逛学习空间」&lt;br&gt;  直接以演示模式进入 /dashboard&lt;br&gt;· 密码可见性切换 eye 图标" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;dashed=0;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="50" y="398" width="226" height="210" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="notes" name="设计说明"><mxGraphModel dx="1120" dy="752" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="940" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c64" value="" style="rounded=1;arcSize=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=0;dashed=0;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeom