Cell><mxCell id="c5" value="模式  demo" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#E0F2FE;strokeColor=#BAE6FD;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#0369A1;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="854.4" y="30" width="73.6" height="24" as="geometry"/></mxCell><mxCell id="c6" value="先讲思路再给步骤：文字或题目图片提问，AI 引导你自己走完解题路径。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="880" height="18" as="geometry"/></mxCell><mxCell id="e7" value="" style="line;html=1;strokeColor=#E5E7EB;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="0" y="140" width="1440" height="1" relative="0" as="geometry"><mxPoint x="0" y="140" as="sourcePoint"/><mxPoint x="1440" y="141" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c8" value="ⓘ   当前为前端演示。示例院校、学习资料与 AI 回复均不代表真实业务结果；本地学习操作仅保存在本浏览器。" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#F5F3FF;strokeColor=#DDD6FE;strokeWidth=1;dashed=0;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#5B21B6;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=14;spacingRight=14;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="178" width="1360" height="40" as="geometry"/></mxCell><mxCell id="c9" value="" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;dashed=0;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="832.04" height="283" as="geometry"/></mxCell><mxCell id="c10" value="把问题说清楚" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="254" width="728.04" height="20" as="geometry"/></mxCell><mxCell id="c11" value="思路优先" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#EEF2FF;strokeColor=#EEF2FF;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#4F46E5;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="798.04" y="255" width="58" height="20" as="geometry"/></mxCell><mxCell id="c12" value="答疑科目" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="280" width="393.02" height="14" as="geometry"/></mxCell><mxCell id="c13" value="数学 ▾" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;dashed=0;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="56" y="296" width="393.02" height="32" as="geometry"/></mxCell><mxCell id="c14" value="▾" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#9CA3AF;fontStyle=0;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="429.02" y="302" width="14" height="20" as="geometry"/></mxCell><mxCell id="c15" value="题目图片" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="463.02" y="280" width="393.02" height="14" as="geometry"/></mxCell><mxCell id="c16" value="⬆ 上传题目图片（JPG / PNG / WebP ≤ 10MB）" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;dashed=0;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=9;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="463.02" y="296" width="393.02" height="32" as="geometry"/></mxCell><mxCell id="c17" value="题干（可直接粘贴原题）" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="340" width="800.04" height="14" as="geometry"/></mxCell><mxCell id="c18" value="输入题干后，AI 会先复述条件与目标，再给出可执行的解题路径。" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;dashed=0;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#9CA3AF;fontStyle=0;align=left;verticalAlign=top;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="56" y="356" width="800.04" height="62" as="geometry"/></mxCell><mxCell id="c19" value="确认题目文字" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#1F2937;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56" y="432" width="98" height="32" as="geometry"/></mxCell><mxCell id="c20" value="图片仅在本机预览，尚未上传；演示模式需自行录入并核对题干。" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFF7ED;strokeColor=#FDBA74;strokeWidth=1;dashed=0;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#B45309;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="56" y="472" width="800.04" height="33" as="geometry"/></mxCell><mxCell id="c21" value="" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;dashed=0;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="539" width="832.04" height="276" as="geometry"/></mxCell><mxCell id="c22" value="AI 引导式答疑" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="553" width="792.04" height="20" as="geometry"/></mxCell><mxCell id="c23" value="我们一起先分析题目条件和解题路径。把你的问题或已尝试的步骤告诉我吧。" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F3F4F6;strokeColor=#F3F4F6;strokeWidth=1;dashed=0;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="56" y="579" width="408" height="38" as="geometry"/></mxCell><mxCell id="c24" value="遇到极限题该怎样选择方法？" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#4F46E5;strokeColor=#4F46E5;strokeWidth=1;dashed=0;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#FFFFFF;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="679.04" y="625" width="177" height="38" as="geometry"/></mxCell><mxCell id="c25" value="【演示解题思路】先明确题目条件和要求，再选择可用的知识点。1. 列出已知条件…" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F3F4F6;strokeColor=#F3F4F6;strokeWidth=1;dashed=0;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="56" y="671" width="443.64" height="38" as="geometry"/></mxCell><mxCell id="c26" value="快捷提问" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#9CA3AF;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="717" width="800.04" height="14" as="geometry"/></mxCell><mxCell id="c27" value="遇到极限题该怎样选择方法？" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#6B7280;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56" y="733" width="143" height="22" as="geometry"/></mxCell><mxCell id="c28" value="如何拆解一道长难句？" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#6B7280;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="205" y="733" width="116" height="22" as="geometry"/></mxCell><mxCell id="c29" value="请帮我检查第一步解题思路" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#6B7280;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="327" y="733" width="134" height="22" as="geometry"/></mxCell><mxCell id="c30" value="输入你的问题…" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;dashed=0;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#9CA3AF;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="56" y="763" width="726.04" height="36" as="geometry"/></mxCell><mxCell id="c31" value="发送" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#4F46E5;strokeColor=#4F46E5;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#FFFFFF;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="790.04" y="763" width="66" height="36" as="geometry"/></mxCell><mxCell id="c32" value="" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;dashed=0;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="890.04" y="240" width="509.96" height="160" as="geometry"/></mxCell><mxCell id="c33" value="从思路到理解" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="906.04" y="254" width="469.96" height="20" as="geometry"/></mxCell><mxCell id="c34" value="" style="ellipse;html=1;fillColor=#EEF2FF;strokeColor=#EEF2FF;" vertex="1" parent="1"><mxGeometry x="906.04" y="281" width="20" height="20" as="geometry"/></mxCell><mxCell id="c35" value="1" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#4F46E5;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="906.04" y="282" width="20" height="16" as="geometry"/></mxCell><mxCell id="c36" value="描述题目条件与目标" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="934.04" y="281" width="449.96" height="18" as="geometry"/></mxCell><mxCell id="c37" value="" style="ellipse;html=1;fillColor=#EEF2FF;strokeColor=#EEF2FF;" vertex="1" parent="1"><mxGeometry x="906.04" y="309" width="20" height="20" as="geometry"/></mxCell><mxCell id="c38" value="2" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#4F46E5;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="906.04" y="310" width="20" height="16" as="geometry"/></mxCell><mxCell id="c39" value="说出你已经尝试的方法" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="934.04" y="309" width="449.96" height="18" as="geometry"/></mxCell><mxCell id="c40" value="" style="ellipse;html=1;fillColor=#EEF2FF;strokeColor=#EEF2FF;" vertex="1" parent="1"><mxGeometry x="906.04" y="337" width="20" height="20" as="geometry"/></mxCell><mxCell id="c41" value="3" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#4F46E5;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="906.04" y="338" width="20" height="16" as="geometry"/></mxCell><mxCell id="c42" value="追问卡住的具体步骤" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="934.04" y="337" width="449.96" height="18" as="geometry"/></mxCell><mxCell id="c43" value="" style="ellipse;html=1;fillColor=#EEF2FF;strokeColor=#EEF2FF;" vertex="1" parent="1"><mxGeometry x="906.04" y="365" width="20" height="20" as="geometry"/></mxCell><mxCell id="c44" value="4" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#4F46E5;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="906.04" y="366" width="20" height="16" as="geometry"/></mxCell><mxCell id="c45" value="用类似问题检验理解" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="934.04" y="365" width="449.96" height="18" as="geometry"/></mxCell><mxCell id="c46" value="" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;dashed=0;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="890.04" y="416" width="509.96" height="142" as="geometry"/></mxCell><mxCell id="c47" value="答疑后的下一步" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="906.04" y="430" width="469.96" height="20" as="geometry"/></mxCell><mxCell id="c48" value="理解一个方法，再用练习巩固。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="906.04" y="456" width="477.96" height="18" as="geometry"/></mxCell><mxCell id="c49" value="把易错点沉淀下来，下一次就更有把握。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="906.04" y="478" width="477.96" height="18" as="geometry"/></mxCell><mxCell id="c50" value="前往专项训练  →" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#1F2937;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="906.04" y="504" width="116.48" height="32" as="geometry"/></mxCell><mxCell id="c51" value="" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;dashed=0;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="890.04" y="574" width="509.96" height="98" as="geometry"/></mxCell><mxCell id="c52" value="内容核验提示" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=13;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="906.04" y="588" width="469.96" height="20" as="geometry"/></mxCell><mxCell id="c53" value="真实 AI 内容可能出错，请核对公式与依据。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="906.04" y="614" width="477.96" height="18" as="geometry"/></mxCell><mxCell id="c54" value="真实模式按返回的来源核验；演示模式不会伪造资料出处。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="906.04" y="636" width="477.96" height="18" as="geometry"/></mxCell><mxCell id="c55" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;dashed=1;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="837" width="1360" height="37" as="geometry"/></mxCell><mxCell id="c56" value="说明" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#92400E;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="845" width="60" height="16" as="geometry"/></mxCell><mxCell id="c57" value="上传流程：选图（类型/大小校验）→ 本地预览 → 录入并确认题目文字 → 作为 context 传入 ChatPanel；演示模式不真正上传图片。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#92400E;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="102" y="845" width="1286" height="21" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="notes" name="设计说明"><mxGraphModel dx="1120" dy="576" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c46" value="" style="rounded=1;arcSize=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=0;dashed=0;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1120" height="720" as="geometry"/></mxCell><mxCell id="c1" value="设计说明 · 09 AI 答疑与解题 /qa" style="text;html=1;whiteSpace=wrap;fon