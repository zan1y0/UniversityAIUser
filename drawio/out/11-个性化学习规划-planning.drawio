" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#9CA3AF;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="312" y="564" width="748" height="15" as="geometry"/></mxCell><mxCell id="e41" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="589" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="589" as="sourcePoint"/><mxPoint x="1080" y="590" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="布局与文案取自 frontend/src 现有实现；操作编号、请求路径与数据表已逐项对照 contracts/openapi.json（141 operations）与 Flyway 迁移（54 张表）。模块表多为 id + owner_id + payload(LONGTEXT) 文档式存储，页面字段落在 payload JSON 内。" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF7ED;strokeColor=#FDBA74;strokeWidth=1;dashed=1;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#B45309;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="603" width="1040" height="66" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>