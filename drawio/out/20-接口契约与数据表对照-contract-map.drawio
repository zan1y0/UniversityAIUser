whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="50" y="958" width="176.4" height="19" as="geometry"/></mxCell><mxCell id="c119" value="00 通用技术接口 + 各模块动作" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="240.4" y="958" width="475.6" height="19" as="geometry"/></mxCell><mxCell id="c120" value="6" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="730" y="958" width="81.2" height="19" as="geometry"/></mxCell><mxCell id="c121" value="jobs / job_commands、event_outbox、files、idempotency_records" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="825.2" y="958" width="570.8" height="19" as="geometry"/></mxCell><mxCell id="e122" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="981" width="1360" height="1" relative="0" as="geometry"><mxPoint x="40" y="981" as="sourcePoint"/><mxPoint x="1400" y="982" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c123" value="" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#F8FAFC;strokeColor=#E5E7EB;strokeWidth=1;dashed=1;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="1001" width="1360" height="96" as="geometry"/></mxCell><mxCell id="c124" value="对照方法与仍需注意的两点" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="1013" width="1328" height="18" as="geometry"/></mxCell><mxCell id="c125" value="方法：以 contracts/openapi.json 的 operationId / path / tag 为准逐个核对页面操作，以 Flyway 迁移文件的 CREATE TABLE 为准核对字段；不臆造接口与表。&lt;br&gt;注意 1：模块数据以 payload JSON 落库，报录比、任务、逐题答案等字段没有独立列，做后端校验时按 payload schema 约束。&lt;br&gt;注意 2：ContractWorkspace 的默认动作 op072 属 M10，M07 的 extras 用 profile 接口，均是实现现状而非契约分组。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="1035" width="1328" height="54" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="notes" name="设计说明"><mxGraphModel dx="1120" dy="449" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="562" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c31" value="" style="rounded=1;arcSize=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=0;dashed=0;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1120" height="562" as="geometry"/></mxCell><mxCell id="c1" value="设计说明 · 20 接口契约与数据表对照" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1040" height="26" as="geometry"/></mxCell><mxCell id="c2" value="每个页面用到哪些契约操作、落到哪些表：以 contracts/openapi.json 与 Flyway 迁移为准的核对结果。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1040" height="16" as="geometry"/></mxCell><mxCell id="e3" value="" style="line;html=1;strokeColor=#E5E7EB;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="110" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="110" as="sourcePoint"/><mxPoint x="1080" y="111" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c4" value="路由" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#9CA3AF;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="128" width="70" height="16" as="geometry"/></mxCell><mxCell id="c5" value="全部页面" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="116" y="128" width="960" height="16" as="geometry"/></mxCell><mxCell id="c6" value="角色" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#9CA3AF;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="70" height="16" as="geometry"/></mxCell><mxCell id="c7" value="STUDENT / TEACHER / ADMIN" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="116" y="150" width="960" height="16" as="geometry"/></mxCell><mxCell id="c8" value="模式" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#9CA3AF;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="172" width="70" height="16" as="geometry"/></mxCell><mxCell id="c9" value="live" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="116" y="172" width="960" height="16" as="geometry"/></mxCell><mxCell id="c10" value="组件" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#9CA3AF;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="194" width="70" height="16" as="geometry"/></mxCell><mxCell id="c11" value="contracts/openapi.json + src/main/resources/db/migration/mysql" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="116" y="194" width="960" height="16" as="geometry"/></mxCell><mxCell id="c12" value="文件" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#9CA3AF;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="70" height="16" as="geometry"/></mxCell><mxCell id="c13" value="20-接口契约与数据表对照-contract-map.drawio" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="116" y="216" width="960" height="16" as="geometry"/></mxCell><mxCell id="c14" value="结构与交互备注" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="246" width="600" height="18" as="geometry"/></mxCell><mxCell id="c15" value="01" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="272" width="26" height="16" as="geometry"/></mxCell><mxCell id="c16" value="核对方式：按 operationId / path / tag 逐个比对页面操作，按 CREATE TABLE 与列定义比对页面字段。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="272" width="1000" height="17" as="geometry"/></mxCell><mxCell id="e17" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="295" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="295" as="sourcePoint"/><mxPoint x="1080" y="296" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="02" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="297" width="26" height="16" as="geometry"/></mxCell><mxCell id="c19" value="首版 5 处语义标注错误已修正：op039 不是图片识别（op038）、op060 不是交卷（op061/op062）、op006–op008 是 files 的上传/读取/删除、op072 属 M10 只是默认动作、示例用户 ID 改为 UUID。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="297" width="1000" height="17" as="geometry"/></mxCell><mxCell id="e20" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="320" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="320" as="sourcePoint"/><mxPoint x="1080" y="321" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="03" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="322" width="26" height="16" as="geometry"/></mxCell><mxCell id="c22" value="模块表是文档式：id VARCHAR(100) + owner_id VARCHAR(36) + version + payload LONGTEXT，页面字段落在 payload JSON。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="322" width="1000" height="17" as="geometry"/></mxCell><mxCell id="e23" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="345" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="345" as="sourcePoint"/><mxPoint x="1080" y="346" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="04" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="347" width="26" height="16" as="geometry"/></mxCell><mxCell id="c25" value="关系表集中在账号、权限、教学与审计：app_users / email_challenges / account_invitations / sys_roles / teaching_tasks / teaching_submissions / security_audit。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="347" width="1000" height="17" as="geometry"/></mxCell><mxCell id="e26" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="370" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="370" as="sourcePoint"/><mxPoint x="1080" y="371" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="数据与接口" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="382" width="600" height="18" as="geometry"/></mxCell><mxCell id="c28" value="· live 模式下 ContractWorkspace 的默认动作与 extras 属于实现细节，与 Apifox 的模块分组不完全一致。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="406" width="1000" height="17" as="geometry"/></mxCell><mxCell id="c29" value="· 接口与表结构如后续变更，本页映射需同步更新：contract_map.py 由 gen_map.py 从 openapi.json 生成。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="429" width="1000" height="17" as="geometry"/></mxCell><mxCell id="c30" value="布局与文案取自 frontend/src 现有实现；操作编号、请求路径与数据表已逐项对照 contracts/openapi.json（141 operations）与 Flyway 迁移（54 张表）。模块表多为 id + owner_id + payload(LONGTEXT) 文档式存储，页面字段落在 payload JSON 内。" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#FFF7ED;strokeColor=#FDBA74;strokeWidth=1;dashed=1;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#B45309;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="1040" height="66" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>