nded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#1F2937;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="691.32" y="426" width="96" height="28" as="geometry"/></mxCell><mxCell id="c48" value="" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;dashed=0;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="675.32" y="482" width="724.68" height="132" as="geometry"/></mxCell><mxCell id="c49" value="结果区（ContractResult 递归渲染）" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="691.32" y="494" width="692.68" height="18" as="geometry"/></mxCell><mxCell id="c50" value="{&lt;br&gt;  &quot;items&quot;: [ { &quot;school&quot;: &quot;华东师范大学&quot;, &quot;line&quot;: 355 } ],&lt;br&gt;  &quot;note&quot;: &quot;来源与口径以接口返回为准&quot;&lt;br&gt;}" style="rounded=1;arcSize=8;html=1;whiteSpace=wrap;fillColor=#0F172A;strokeColor=#0F172A;strokeWidth=1;dashed=0;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#E2E8F0;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="691.32" y="520" width="692.68" height="82" as="geometry"/></mxCell><mxCell id="c51" value="" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;dashed=0;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="675.32" y="630" width="724.68" height="60" as="geometry"/></mxCell><mxCell id="c52" value="错误与重试" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="691.32" y="640" width="692.68" height="18" as="geometry"/></mxCell><mxCell id="c53" value="error：契约返回的业务错误码与可读说明" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#6B7280;fontStyle=0;align=right;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="795.32" y="642" width="588.68" height="16" as="geometry"/></mxCell><mxCell id="c54" value="重试上次操作" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#1F2937;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="691.32" y="660" width="96" height="24" as="geometry"/></mxCell><mxCell id="c55" value="" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1;dashed=1;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="40" y="710" width="1360" height="118" as="geometry"/></mxCell><mxCell id="c56" value="模块差异（extras）与关键实现" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#92400E;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="720" width="800" height="18" as="geometry"/></mxCell><mxCell id="c57" value="moduleMap：/companion→M01、/schools→M02、/public-courses→M03、/professional-courses→M04、/qa→M05、/practice→M06、/planning→M07、/exams→M08、/interview→M09、/dashboard→M10、/news→M11。&lt;br&gt;默认选中动作：M02 用 op019（专业目录检索），其余模块用 op072（学习数据总览，属 M10）；M07 额外追加 op004 / op005（profile 读写），M01、M05、M09 额外追加 op006 / op007 / op008（文件上传、读取、删除）。&lt;br&gt;op.multipart 走上传（题目图片、录音），提交前展示文件名与大小；等待中可中止，卸载时清理 AbortController 与订阅。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#92400E;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="744" width="1328" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="notes" name="设计说明"><mxGraphModel dx="1120" dy="716" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="895" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c60" value="" style="rounded=1;arcSize=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#FFFFFF;strokeWidth=0;dashed=0;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1120" height="895" as="geometry"/></mxCell><mxCell id="c1" value="设计说明 · 19 真实模式契约工作台 ContractWorkspace" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=19;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="1040" height="26" as="geometry"/></mxCell><mxCell id="c2" value="frontend/src/components/ContractWorkspace.vue · live 模式下替换 M01–M11 的页面内容" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1040" height="16" as="geometry"/></mxCell><mxCell id="e3" value="" style="line;html=1;strokeColor=#E5E7EB;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="110" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="110" as="sourcePoint"/><mxPoint x="1080" y="111" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c4" value="路由" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#9CA3AF;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="128" width="70" height="16" as="geometry"/></mxCell><mxCell id="c5" value="M01–M11（live）" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="116" y="128" width="960" height="16" as="geometry"/></mxCell><mxCell id="c6" value="角色" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#9CA3AF;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="70" height="16" as="geometry"/></mxCell><mxCell id="c7" value="STUDENT" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="116" y="150" width="960" height="16" as="geometry"/></mxCell><mxCell id="c8" value="模式" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#9CA3AF;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="172" width="70" height="16" as="geometry"/></mxCell><mxCell id="c9" value="live" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="116" y="172" width="960" height="16" as="geometry"/></mxCell><mxCell id="c10" value="组件" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#9CA3AF;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="194" width="70" height="16" as="geometry"/></mxCell><mxCell id="c11" value="frontend/src/components/ContractWorkspace.vue" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="116" y="194" width="960" height="16" as="geometry"/></mxCell><mxCell id="c12" value="文件" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#9CA3AF;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="216" width="70" height="16" as="geometry"/></mxCell><mxCell id="c13" value="19-真实模式契约工作台-contract-workspace.drawio" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="116" y="216" width="960" height="16" as="geometry"/></mxCell><mxCell id="c14" value="结构与交互备注" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="246" width="600" height="18" as="geometry"/></mxCell><mxCell id="c15" value="01" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="272" width="26" height="16" as="geometry"/></mxCell><mxCell id="c16" value="moduleMap 把 11 条路由映射到 M01–M11；默认选中动作 M02 用 op019，其余用 op072（M10 仪表盘接口，实现的跨模块默认值）。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="272" width="1000" height="17" as="geometry"/></mxCell><mxCell id="e17" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="295" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="295" as="sourcePoint"/><mxPoint x="1080" y="296" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="02" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="297" width="26" height="16" as="geometry"/></mxCell><mxCell id="c19" value="actionIds：operations 中 tag 以模块编码开头、且路径不以 /api/v1/study- 开头（后者是内部数据接口，不作为动作）。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="297" width="1000" height="17" as="geometry"/></mxCell><mxCell id="e20" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="320" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="320" as="sourcePoint"/><mxPoint x="1080" y="321" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="03" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="322" width="26" height="16" as="geometry"/></mxCell><mxCell id="c22" value="extras：M07 追加 op004 / op005（profile 读取与写回）；M01、M05、M09 追加 op006 / op007 / op008（文件上传、读取、删除）。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="322" width="1000" height="17" as="geometry"/></mxCell><mxCell id="e23" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="345" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="345" as="sourcePoint"/><mxPoint x="1080" y="346" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="04" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="347" width="26" height="16" as="geometry"/></mxCell><mxCell id="c25" value="op.multipart 走上传（题目图片、录音），提交前展示文件名与大小；op.body 走 ContractField 动态表单。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="347" width="1000" height="17" as="geometry"/></mxCell><mxCell id="e26" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="370" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="370" as="sourcePoint"/><mxPoint x="1080" y="371" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="05" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="372" width="26" height="16" as="geometry"/></mxCell><mxCell id="c28" value="执行流程：execute → 返回 job 时 waitJob 轮询进度 → subscribeEvents 接收中间态 → ContractResult 渲染结果。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="372" width="1000" height="17" as="geometry"/></mxCell><mxCell id="e29" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="395" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="395" as="sourcePoint"/><mxPoint x="1080" y="396" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="06" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="397" width="26" height="16" as="geometry"/></mxCell><mxCell id="c31" value="错误处理：显示 error 文案 + 「重试上次操作」；等待中可「停止等待」；卸载时中止 AbortController 与订阅。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="397" width="1000" height="17" as="geometry"/></mxCell><mxCell id="e32" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="420" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="420" as="sourcePoint"/><mxPoint x="1080" y="421" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="07" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="422" width="26" height="16" as="geometry"/></mxCell><mxCell id="c34" value="表单校验在前端先跑一遍，字段级错误内联显示，不发起请求。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="422" width="1000" height="17" as="geometry"/></mxCell><mxCell id="e35" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="445" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="445" as="sourcePoint"/><mxPoint x="1080" y="446" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="08" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="447" width="26" height="16" as="geometry"/></mxCell><mxCell id="c37" value="该外壳只负责「按契约取数与展示」，不实现业务规则；排序、评分、推荐策略都在后端。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="447" width="1000" height="17" as="geometry"/></mxCell><mxCell id="e38" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="470" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="470" as="sourcePoint"/><mxPoint x="1080" y="471" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="数据与接口" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="482" width="600" height="18" as="geometry"/></mxCell><mxCell id="c40" value="· 真实数据以接口返回为准，前端不编造院校分数、录取概率或估分排名。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="506" width="1000" height="17" as="geometry"/></mxCell><mxCell id="c41" value="· 契约操作定义见前端 src/api 与后端 /api/v1 契约文档，字段名即 form 的 key。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="529" width="1000" height="17" as="geometry"/></mxCell><mxCell id="c42" value="接口契约与数据表" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="600" height="18" as="geometry"/></mxCell><mxCell id="c43" value="契约范围：00 通用技术接口 + 各模块动作" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="586" width="1000" height="17" as="geometry"/></mxCell><mxCell id="c44" value="· op001 GET /session/csrf" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="611" width="980" height="15" as="geometry"/></mxCell><mxCell id="c45" value="· op006 POST /files" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="626" width="980" height="15" as="geometry"/></mxCell><mxCell id="c46" value="· op007 GET /files/{id}" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="641" width="980" height="15" as="geometry"/></mxCell><mxCell id="c47" value="· op008 DELETE /files/{id}" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="656" width="980" height="15" as="geometry"/></mxCell><mxCell id="c48" value="· op009 GET /jobs/{id}" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="671" width="980" height="15" as="geometry"/></mxCell><mxCell id="c49" value="· op010 GET /events" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="686" width="980" height="15" as="geometry"/></mxCell><mxCell id="c50" value="· jobs / job_commands" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="709" width="250" height="15" as="geometry"/></mxCell><mxCell id="c51" value="异步任务与等待（op009）" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#9CA3AF;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="312" y=