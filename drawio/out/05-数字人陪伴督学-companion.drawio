metry x="56" y="546" width="765.2" height="20" as="geometry"/></mxCell><mxCell id="c22" value="当前计划有 0 项到期或待完成任务（未生成计划时提示先确认计划）。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="572" width="773.2" height="18" as="geometry"/></mxCell><mxCell id="c23" value="☑ 开启演示页内提醒（live 模式禁用）" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="594" width="773.2" height="18" as="geometry"/></mxCell><mxCell id="c24" value="此偏好只控制演示页内提醒；浏览器关闭后的提醒需后端调度与通知接口。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="616" width="773.2" height="18" as="geometry"/></mxCell><mxCell id="c25" value="有超期任务时显示 notice：可前往学习计划调整安排。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="56" y="638" width="773.2" height="18" as="geometry"/></mxCell><mxCell id="c26" value="前往学习计划" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;fontFamily=Microsoft YaHei;fontSize=11;fontColor=#1F2937;fontStyle=0;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="56" y="664" width="98" height="32" as="geometry"/></mxCell><mxCell id="c27" value="" style="rounded=1;arcSize=10;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#E5E7EB;strokeWidth=1;dashed=0;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontStyle=0;align=left;verticalAlign=middle;spacingLeft=10;spacingRight=10;spacingTop=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="863.2" y="240" width="536.8" height="164" as="ge