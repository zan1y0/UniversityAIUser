学习模块在 router/index.ts 的 modules 数组中声明（path / title / short / module / icon / group / subtitle），侧栏据此渲染。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="297" width="1000" height="17" as="geometry"/></mxCell><mxCell id="e20" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="320" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="320" as="sourcePoint"/><mxPoint x="1080" y="321" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="03" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="322" width="26" height="16" as="geometry"/></mxCell><mxCell id="c22" value="侧栏分组：概览（M10）、学习（M01–M05）、提升（M06–M09）、资讯（M11）、教学（T01/T02）、平台管理（ADMIN）。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="322" width="1000" height="17" as="geometry"/></mxCell><mxCell id="e23" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="345" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="345" as="sourcePoint"/><mxPoint x="1080" y="346" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="04" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="347" width="26" height="16" as="geometry"/></mxCell><mxCell id="c25" value="角色可见性：TEACHER 只看到 /teacher；ADMIN 只看到 /admin；学生隐藏 /teacher，/companion 仅在演示模式出现。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="347" width="1000" height="17" as="geometry"/></mxCell><mxCell id="e26" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="370" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="370" as="sourcePoint"/><mxPoint x="1080" y="371" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="05" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="372" width="26" height="16" as="geometry"/></mxCell><mxCell id="c28" value="live 模式下 M01–M11 的内容区被 ContractWorkspace 接管，故 04–14 号文件描述的是演示模式 UI。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="372" width="1000" height="17" as="geometry"/></mxCell><mxCell id="e29" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="395" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="395" as="sourcePoint"/><mxPoint x="1080" y="396" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="06" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="397" width="26" height="16" as="geometry"/></mxCell><mxCell id="c31" value="未登录访问受保护路由 → /login?redirect=&lt;path&gt;；越权 → roleHome(role) 或 /forbidden。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="397" width="1000" height="17" as="geometry"/></mxCell><mxCe