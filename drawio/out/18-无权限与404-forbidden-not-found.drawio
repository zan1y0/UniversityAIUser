ght="16" as="geometry"/></mxCell><mxCell id="c19" value="返回目标 = app.user ? roleHome(user) : '/login'，避免未登录用户被反复弹回。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="297" width="1000" height="17" as="geometry"/></mxCell><mxCell id="e20" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="320" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="320" as="sourcePoint"/><mxPoint x="1080" y="321" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="03" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="322" width="26" height="16" as="geometry"/></mxCell><mxCell id="c22" value="404 由 /:pathMatch(.*)* 兜底，提示从左侧导航选择学习模块，不出现空白页。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="322" width="1000" height="17" as="geometry"/></mxCell><mxCell id="e23" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="345" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="345" as="sourcePoint"/><mxPoint x="1080" y="346" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="04" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="347" width="26" height="16" as="geometry"/></mxCell><mxCell id="c25" value="两页都在 .app-shell 内，因此仍可切换模式、切换角色或退出登录。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;vertica