"/><mxPoint x="1080" y="396" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c30" value="06" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="397" width="26" height="16" as="geometry"/></mxCell><mxCell id="c31" value="token 缺失或过期时提示链接失效，并给出重新获取邀请的说明。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="397" width="1000" height="17" as="geometry"/></mxCell><mxCell id="e32" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="420" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="420" as="sourcePoint"/><mxPoint x="1080" y="421" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c33" value="数据与接口" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="432" width="600" height="18" as="geometry"/></mxCell><mxCell id="c34" value="· 接口：POST /auth/activation/code 发送验证码，POST /auth/activation/activate 完成激活。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="1000" height="17" as="geometry"/></mxCell><mxCell id="c35" value="· 激活会写入审计日志（操作来源、时间、邀请 id），便于管理员排查。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="479" width="1000" height="17" as="geometry"/></mxCell><mxCell id="c36" value="接口契约与数据表" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=12;fontColor=#1F2937;fontS