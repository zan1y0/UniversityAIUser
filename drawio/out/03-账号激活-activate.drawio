c16" value="meta.public 为真：即使 live 模式未登录也允许访问，页面无侧栏无顶栏。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="272" width="1000" height="17" as="geometry"/></mxCell><mxCell id="e17" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="295" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="295" as="sourcePoint"/><mxPoint x="1080" y="296" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c18" value="02" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="297" width="26" height="16" as="geometry"/></mxCell><mxCell id="c19" value="邀请邮箱只读，防止用他人邀请激活；可填旧账号密码以合并历史账号。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="297" width="1000" height="17" as="geometry"/></mxCell><mxCell id="e20" value="" style="line;html=1;strokeColor=#F1F5F9;strokeWidth=1;dashed=0;" edge="1" parent="1"><mxGeometry x="40" y="320" width="1040" height="1" relative="0" as="geometry"><mxPoint x="40" y="320" as="sourcePoint"/><mxPoint x="1080" y="321" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c21" value="03" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=9;fontColor=#4F46E5;fontStyle=1;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="40" y="322" width="26" height="16" as="geometry"/></mxCell><mxCell id="c22" value="运维凭据为可选字段，仅管理员发放临时凭据时使用。" style="text;html=1;whiteSpace=wrap;fontFamily=Microsoft YaHei;fontSize=10;fontColor=#6B7280;fontStyle=0;align=left;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="66" y="322" width="1000"