{
  "name": "kaoyan-ai-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "format": "prettier --write src tests *.ts *.json index.html README.md deploy/nginx.conf --ignore-unknown",
    "format:check": "prettier --check src tests *.ts *.json index.html README.md --ignore-unknown",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "pinia": "^3.0.0",
    "lucide-vue-next": "^0.468.0",
    "echarts": "^6.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.0",
    "vue-tsc": "^3.1.0",
    "vitest": "^4.0.0",
    "prettier": "^3.6.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0"
  }
}
