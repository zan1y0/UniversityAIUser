# MySQL 连接变量示例。mysql profile 也可读取被 Git 忽略的 .local-data/mysql-local.properties。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=kaoyan_ai
MYSQL_USER=
MYSQL_PASSWORD=
# Docker Compose 创建 MySQL 容器时必填；不会修改已有数据卷中的 root 密码。
MYSQL_ROOT_PASSWORD=
# 可选：本地 H2 文件数据库密码；已有数据库必须使用其原密码。
LOCAL_DB_PASSWORD=
# OpenAI 兼容服务；暂未配置，不返回虚构模型结果。
AI_LLM_BASE_URL=
AI_LLM_API_KEY=
AI_LLM_MODEL=
AI_VISION_MODEL=
AI_AUDIO_MODEL=
# local profile 首次初始化种子账号时必填；不提供默认密码，不修改已有账号。
LOCAL_STUDENT_PASSWORD=

# 可选：MP3、WebM、OGG 实际时长检查工具的完整路径。WAV 无需此配置。
APP_FFPROBE_EXECUTABLE=
# JWT：使用加密随机数生成至少32字节，并Base64编码；mysql/dev/prod必须设置。
APP_JWT_SECRET=
APP_JWT_TTL_SECONDS=1800
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
