# MySQL 连接变量示例。mysql profile 也可读取被 Git 忽略的 .local-data/mysql-local.properties。
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DB=kaoyan_ai
MYSQL_USER=
MYSQL_PASSWORD=
# Docker Compose 创建 MySQL 容器时必填；不会修改已有数据卷中的 root 密码。
MYSQL_ROOT_PASSWORD=
# 可选：本地 H2 文件数据库密码；已有数据库必须使用其原密码。
LOCAL_DB_PASSWORD=
# OpenAI 兼容服务；暂未配置，不返回虚构模型结果。
AI_LLM_BASE_URL=
AI_LLM_API_KEY=
AI_LLM_MODEL=
AI_VISION_MODEL=
AI_AUDIO_MODEL=
AI_KT_ENABLED=false
AI_KT_BASE_URL=
AI_KT_TIMEOUT_MS=800
AI_KT_MODEL_VERSION=kt-gkt-v1
AI_KT_PREVIOUS_MODEL_VERSION=
# local profile 首次初始化种子账号时必填；不提供默认密码，不修改已有账号。
LOCAL_STUDENT_PASSWORD=

# 可选：MP3、WebM、OGG 实际时长检查工具的完整路径。WAV 无需此配置。
APP_FFPROBE_EXECUTABLE=
# JWT：使用加密随机数生成至少32字节，并Base64编码；mysql/dev/prod必须设置。
APP_JWT_SECRET=
APP_JWT_TTL_SECONDS=1800
APP_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Redis 读缓存与启动预热，可选：不装 Redis 也能启动，连不上时自动降级为直查数据库。
# 只在确定有 Redis 的机器上把 APP_REDIS_CACHE_ENABLED 设为 true，否则每 30 秒会有一次连接失败重试。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 本机密码可放在被 Git 忽略的 .local-data/redis-local.properties。Compose 的 Redis 无密码。
REDIS_PASSWORD=
# 旧的 REDIS_DB 仍可使用；未设置 REDIS_DATABASE 时读取 REDIS_DB。
REDIS_DATABASE=0
REDIS_TIMEOUT=800ms
REDIS_CONNECT_TIMEOUT=800ms
REDIS_KEY_PREFIX=kaoyan-ai:
APP_REDIS_CACHE_ENABLED=false
APP_REDIS_CACHE_TTL=1800
APP_REDIS_WARMUP_TABLES=programs,subjects,books,knowledge_trees,questions,papers,notices,milestones

# RabbitMQ 消息队列（任务投递 + 事件广播），可选：不装也能启动，任务退回 500ms 数据库轮询。
# 开启后如果 RabbitMQ 不可用，默认每 60 秒重试。
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
APP_MQ_ENABLED=false
# MQ 开启后数据库兜底扫描的间隔（毫秒），默认 30 秒
APP_MQ_SAFETY_SCAN_MILLIS=30000

# 邮箱认证及一次性管理员初始化
APP_SMTP_HOST=
APP_SMTP_PORT=587
APP_SMTP_USERNAME=
APP_SMTP_PASSWORD=
APP_SMTP_AUTH=true
# 587 端口用 STARTTLS=true + SSL=false；465 端口用 STARTTLS=false + SSL=true，两者不可同时为 true。
APP_SMTP_STARTTLS=true
APP_SMTP_SSL=false
# 发件人必须与 APP_SMTP_USERNAME 是同一个邮箱，QQ 邮箱不允许 From 与登录账号不同。
APP_MAIL_FROM=
APP_EMAIL_CODE_SECRET=
APP_PUBLIC_URL=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=
