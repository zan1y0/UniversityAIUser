<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kaoyan.ai.persistence.mapper.AuthTokenMapper">

  <select id="countActive" resultType="int">
    SELECT COUNT(*) FROM auth_tokens WHERE token_id=#{id} AND user_id=#{user} AND expires_at&gt;#{now}
  </select>
  <delete id="deleteExpired">DELETE FROM auth_tokens WHERE expires_at&lt;=#{now}</delete>
  <insert id="insert">INSERT INTO auth_tokens(token_id,user_id,expires_at) VALUES (#{id},#{user},#{expires})</insert>
  <delete id="delete">DELETE FROM auth_tokens WHERE token_id=#{id} AND user_id=#{user}</delete>
</mapper>
