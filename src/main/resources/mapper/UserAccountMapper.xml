<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kaoyan.ai.persistence.mapper.UserAccountMapper">

  <resultMap id="account" type="com.kaoyan.ai.persistence.entity.UserAccount">
    <constructor>
      <idArg column="id" javaType="java.lang.String"/>
      <arg column="login_name" javaType="java.lang.String"/>
      <arg column="display_name" javaType="java.lang.String"/>
      <arg column="password_hash" javaType="java.lang.String"/>
    </constructor>
  </resultMap>
  <select id="findByLoginName" resultMap="account">
    SELECT id,login_name,display_name,password_hash FROM app_users WHERE login_name=#{loginName}
  </select>
  <select id="findById" resultMap="account">
    SELECT id,login_name,display_name,password_hash FROM app_users WHERE id=#{id}
  </select>
  <select id="countById" resultType="int">SELECT COUNT(*) FROM app_users WHERE id=#{id}</select>
  <insert id="insert">
    INSERT INTO app_users(id,login_name,display_name,password_hash)
    VALUES (#{id},#{loginName},#{displayName},#{passwordHash})
  </insert>
  <select id="lockById" resultType="string">SELECT id FROM app_users WHERE id=#{id} FOR UPDATE</select>
  <select id="findAllIds" resultType="string">SELECT id FROM app_users ORDER BY id</select>
</mapper>
