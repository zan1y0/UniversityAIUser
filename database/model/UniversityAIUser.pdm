                            <a:ObjectID>D499E121-23AD-4609-973C-EB491306E514</a:ObjectID>
                            <a:Name>SqlAttrQuery</a:Name>
                            <a:TextTargetItem.Value>{CATALOG, TABLE, COMMENT}

select
   t.table_schema,
   t.table_name,
   t.table_comment
from
   information_schema.tables t
where 
   t.table_type='BASE TABLE'
[  and t.table_schema = %.q:CATALOG%]
[  and t.table_name = %.q:TABLE%]
order by 1, 2</a:TextTargetItem.Value>
