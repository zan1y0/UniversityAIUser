                            <a:Name>SqlListQuery</a:Name>
                            <a:TextTargetItem.Value>{TABLE, TRIGGER, TRGEVENT, TRGTIME}

select 
   t.event_object_table,
   t.trigger_name,
   t.event_manipulation,
   t.action_timing
from
   information_schema.triggers t
where 1=1
[  and (t.trigger_schema = %.q:CATALOG% or t.event_object_schema = %.q:CATALOG%)]
[  and t.event_object_table = %.q:TABLE%]
order by 1, 2, 3, 4</a:TextTargetItem.Value>
