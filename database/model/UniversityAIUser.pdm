                          <o:TextTargetItem Id="o61">
                            <a:ObjectID>3C3556B4-547B-4BC0-B906-081F86306EFF</a:ObjectID>
                            <a:Name>SqlListQuery</a:Name>
                            <a:TextTargetItem.Value>{CATALOG, TABLE}

select
   t.table_schema,
   t.table_name
from
   information_schema.tables t
where 
   t.table_type='BASE TABLE'
[  and t.table_schema = %.q:CATALOG%]
order by 1, 2</a:TextTargetItem.Value>
                            <a:CreationDate>0</a:CreationDate>
