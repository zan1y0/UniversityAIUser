                            <a:TextTargetItem.Value>{VIEW, COMMENT, SQL}

select
   v.table_name,
   t.table_comment,
   v.view_definition
from
   information_schema.tables t, information_schema.views v
where 
   t.table_schema = v.table_schema
   and t.table_name=v.table_name
[  and v.table_schema = %.q:CATALOG%]
[  and v.table_name = %.q:VIEW%]
order by 1</a:TextTargetItem.Value>
